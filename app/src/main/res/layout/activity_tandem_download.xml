<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tandemStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Put the pump in Bluetooth → Pair Device, then tap Connect. Boluses, carbs and basal appear on the normal xDrip screens."
        android:textStyle="bold"
        android:textSize="14sp" />

    <!-- Pairing entry (the only pump-specific input) -->
    <LinearLayout
        android:id="@+id/tandemPairingRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:visibility="gone">
        <EditText
            android:id="@+id/tandemPairingInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Pairing code from pump"
            android:inputType="textCapCharacters"
            android:autofillHints="" />
        <Button
            android:id="@+id/tandemPairButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pair" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">
        <Button
            android:id="@+id/tandemConnectButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Enable &amp; Sync" />
        <Button
            android:id="@+id/tandemDisableButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Disable" />
        <Button
            android:id="@+id/tandemOpenButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Open xDrip" />
    </LinearLayout>

    <!-- Pump metadata (no native xDrip source for these) -->
    <TextView
        android:id="@+id/tandemMetaTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Pump status"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/tandemMetaText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="monospace"
        android:textSize="13sp"
        android:text="—" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Log"
        android:textStyle="bold" />
    <ScrollView
        android:id="@+id/tandemLogScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:background="#11000000">
        <TextView
            android:id="@+id/tandemLogText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="10sp"
            android:padding="6dp"
            android:textIsSelectable="true" />
    </ScrollView>
</LinearLayout>
